local function runScan()
    State.abort, State.running, State.scanned = false, true, 0
    for k in pairs(State.counts)  do State.counts[k] = 0 end
    for k in pairs(State.results) do State.results[k] = {} end

    local ok, all = pcall(game.GetDescendants, game)
    local total = ok and #all or 10000

    local steps = {
        {"Architecture",  scanArchitecture},
        {"Objets WS",     function() scanObjects(Workspace) end},
        {"Objets RS",     function() scanObjects(ReplicatedStorage) end},
        {"Objets SP",     function() scanObjects(StarterPlayer) end},
        {"Remotes",       scanRemotes},
        {"Scripts",       scanScripts},
        {"Interactions",  scanInteractions},
        {"Interface",     scanGui},
        {"Paramètres",    scanConfig},
        {"Relations",     scanRelations},
    }

    for i, step in ipairs(steps) do
        if State.abort then break end
        local pok, err = pcall(step[2])
        if not pok then warn("Err " .. step[1] .. ": " .. tostring(err)) end
        GUI.updateProgress(math.floor((i / #steps) * 100), step[1])
        task.wait(0.1)
    end

    State.running = false
    if State.abort then
        GUI.updateProgress(0, "Scan interrompu")
        notify("Analyzer", "Scan interrompu", 3)
    else
        GUI.updateProgress(100, "Terminé")
        notify("Analyzer", "Scan terminé — " .. State.scanned .. " objets", 4)
    end
    refreshResults()
end

