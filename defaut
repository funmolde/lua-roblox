local OBJECT_CLASSES = {
    Model=true, Part=true, MeshPart=true, UnionOperation=true,
    WedgePart=true, CornerWedgePart=true, VehicleSeat=true, Seat=true,
    SpawnLocation=true, Folder=true, Configuration=true,
}

local function classify(inst)
    local n = string.lower(inst.Name)
    local cls = inst.ClassName
    if cls == "Tool" then return "items" end
    if not OBJECT_CLASSES[cls] then return nil end
    if string.find(n, "car") or string.find(n, "vehicle") or string.find(n, "truck")
        or string.find(n, "bike") or string.find(n, "tractor") or string.find(n, "plane")
        or string.find(n, "veh") or string.find(n, "voiture") then
        return "vehicles"
    elseif string.find(n, "item") or string.find(n, "pickup") or string.find(n, "collect")
        or string.find(n, "wood") or string.find(n, "stone") or string.find(n, "iron")
        or string.find(n, "gold") or string.find(n, "coin") or string.find(n, "cash") then
        return "items"
    elseif string.find(n, "zone") or string.find(n, "chunk") or string.find(n, "region")
        or string.find(n, "plot") or string.find(n, "base") or string.find(n, "land") then
        return "config"
    end
    return "objects"
end

local function scanArchitecture()
    addResult("architecture", "═══ ARCHITECTURE ═══")
    addResult("architecture", "PlaceId: " .. game.PlaceId)
    addResult("architecture", "Heure  : " .. os.date("%d/%m/%Y %H:%M"))
    local services = {Workspace, ReplicatedStorage, ReplicatedFirst, Players,
                      StarterGui, StarterPlayer, Lighting, SoundService, Teams, CollectionService}
    for _, svc in ipairs(services) do
        if not batchWait() then return end
        if alive(svc) then
            addResult("architecture", string.format("%s → %d enfants", svc.ClassName, childrenCount(svc)))
            local ok, kids = pcall(svc.GetChildren, svc)
            if ok then
                for _, ch in ipairs(kids) do
                    if alive(ch) then
                        addResult("architecture", string.format("  └ %s [%s] → %d",
                            ch.Name, ch.ClassName, childrenCount(ch)))
                    end
                end
            end
            State.scanned += 1
        end
    end
end

local function scanObjects(root)
    local queue = {root}
    while #queue > 0 do
        if not batchWait() then return end
        local inst = table.remove(queue)
        State.scanned += 1
        if alive(inst) and matches(inst) then
            local cat = classify(inst)
            if cat then
                local line = string.format(
                    "%s\n  Classe  : %s\n  Chemin  : %s\n  Parent  : %s\n  Enfants : %d",
                    inst.Name, inst.ClassName, shortPath(inst, 8),
                    alive(inst.Parent) and inst.Parent.Name or "orphan", childrenCount(inst))
                local props = propsOf(inst)
                if props ~= "" then line ..= "\n  Props   : " .. props end
                local attrs = attrsOf(inst)
                if attrs ~= "" then line ..= "\n  Attrs   : " .. attrs end
                local tags = tagsOf(inst)
                if tags ~= "" then line ..= "\n  Tags    : " .. tags end
                addResult(cat, line .. "\n  " .. string.rep("─", 40))
            end
            local ok, kids = pcall(inst.GetChildren, inst)
            if ok then
                for _, ch in ipairs(kids) do
                    if alive(ch) then table.insert(queue, ch) end
                end
            end
        end
    end
end

local REMOTE_CLASSES = {RemoteEvent=true, RemoteFunction=true,
                        BindableEvent=true, BindableFunction=true}

local function scanRemotes()
    local queue = {ReplicatedStorage, ReplicatedFirst, Workspace, StarterGui, StarterPlayer}
    while #queue > 0 do
        if not batchWait() then return end
        local inst = table.remove(queue)
        State.scanned += 1
        if alive(inst) then
            if REMOTE_CLASSES[inst.ClassName] and matches(inst) then
                local hints = {
                    RemoteEvent     = "FireServer(player,...) / FireClient(p,...) / FireAllClients(...)",
                    RemoteFunction  = "InvokeServer(...) / InvokeClient(p,...)",
                    BindableEvent   = "Fire(...)",
                    BindableFunction= "Invoke(...)",
                }
                addResult("remotes", string.format(
                    "%s\n  Type    : %s\n  Chemin  : %s\n  Méthodes: %s\n  %s",
                    inst.Name, inst.ClassName, getPath(inst),
                    hints[inst.ClassName], string.rep("─", 40)))
            end
            local ok, kids = pcall(inst.GetChildren, inst)
            if ok then
                for _, ch in ipairs(kids) do
                    if alive(ch) then table.insert(queue, ch) end
                end
            end
        end
    end
end

local SCRIPT_CLASSES = {Script=true, LocalScript=true, ModuleScript=true}

local function scanScripts()
    local queue = {ReplicatedStorage, ReplicatedFirst, StarterGui, StarterPlayer, Workspace, LocalPlayer}
    while #queue > 0 do
        if not batchWait() then return end
        local inst = table.remove(queue)
        State.scanned += 1
        if alive(inst) then
            if SCRIPT_CLASSES[inst.ClassName] and matches(inst) then
                local src = ""
                local ok, code = pcall(function() return inst.Source end)
                if ok and type(code) == "string" then
                    src = "\n  Source  : ACCESSIBLE"
                else
                    src = "\n  Source  : protégé"
                end
                local line = string.format("%s\n  Type    : %s\n  Chemin  : %s%s",
                    inst.Name, inst.ClassName, getPath(inst), src)

                if type(code) == "string" then
                    local funcs = {}
                    for fn in string.gmatch(code, "function%s+([%w_:%.]+)") do
                        table.insert(funcs, fn)
                        if #funcs >= 10 then break end
                    end
                    if #funcs > 0 then line ..= "\n  Fonctions: " .. table.concat(funcs, ", ") end
                    local reqs = {}
                    for req in string.gmatch(code, "require%s*%(%s*([%w_%.:%s]+)%)") do
                        table.insert(reqs, req)
                        if #reqs >= 8 then break end
                    end
                    if #reqs > 0 then line ..= "\n  Require : " .. table.concat(reqs, ", ") end
                end

                local n = string.lower(inst.Name)
                local role = "module"
                if string.find(n, "service") then role = "Service (Knit)"
                elseif string.find(n, "controller") then role = "Controller (Knit)"
                elseif string.find(n, "config") or string.find(n, "settings") then role = "Config"
                elseif string.find(n, "item") or string.find(n, "data") or string.find(n, "db") then role = "DB items"
                elseif string.find(n, "ui") or string.find(n, "interface") then role = "Module UI" end
                line ..= "\n  Rôle    : " .. role
                addResult("modules", line .. "\n  " .. string.rep("─", 40))
            end
            local ok, kids = pcall(inst.GetChildren, inst)
            if ok then
                for _, ch in ipairs(kids) do
                    if alive(ch) then table.insert(queue, ch) end
                end
            end
        end
    end
end

local function scanInteractions()
    local queue = {Workspace, StarterGui, StarterPlayer, ReplicatedStorage}
    while #queue > 0 do
        if not batchWait() then return end
        local inst = table.remove(queue)
        State.scanned += 1
        if alive(inst) then
            local cls = inst.ClassName
            local line = nil
            if cls == "ProximityPrompt" then
                local a, o, h = "", "", ""
                pcall(function() a = inst.ActionText end)
                pcall(function() o = inst.ObjectName end)
                pcall(function() h = inst.HoldDuration end)
                line = string.format("ProximityPrompt\n  Action  : %s | Objet: %s | Hold: %s\n  Chemin  : %s",
                    a, o, h, getPath(inst))
            elseif cls == "ClickDetector" then
                line = string.format("ClickDetector\n  Chemin  : %s", getPath(inst))
            elseif cls == "TouchTransmitter" then
                line = string.format("TouchTransmitter\n  Parent  : %s [%s]\n  Chemin  : %s",
                    alive(inst.Parent) and inst.Parent.Name or "?",
                    alive(inst.Parent) and inst.Parent.ClassName or "?", getPath(inst))
            elseif cls == "VehicleSeat" then
                local sp, tq = "", ""
                pcall(function() sp = tostring(inst.MaxSpeed) end)
                pcall(function() tq = tostring(inst.Torque) end)
                line = string.format("VehicleSeat\n  MaxSpeed: %s | Torque: %s\n  Chemin  : %s",
                    sp, tq, getPath(inst))
            elseif cls == "Tool" then
                line = string.format("Tool\n  Chemin  : %s", getPath(inst))
            end
            if line and matches(inst) then
                addResult("interactions", inst.Name .. "\n  " .. line .. "\n  " .. string.rep("─", 40))
            end
            local ok, kids = pcall(inst.GetChildren, inst)
            if ok then
                for _, ch in ipairs(kids) do
                    if alive(ch) then table.insert(queue, ch) end
                end
            end
        end
    end
end

