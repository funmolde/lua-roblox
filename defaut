-- ============ SCAN DU PERSONNAGE ============

local function scanCharacter()
    local char = LocalPlayer.Character
    if not char then return end

    print("\n╔══════════════════════════════════════╗")
    print("║       PERSONNAGE DU JOUEUR            ║")
    print("╚══════════════════════════════════════╝")

    for _, obj in ipairs(char:GetDescendants()) do
        print("  [" .. obj.ClassName .. "] " .. obj.Name)
    end

    -- Backpack
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        print("\n--- BACKPACK ---")
        for _, obj in ipairs(backpack:GetChildren()) do
            print("  [" .. obj.ClassName .. "] " .. obj.Name)
            if obj:IsA("Tool") then
                for _, sub in ipairs(obj:GetChildren()) do
                    print("    └─ [" .. sub.ClassName .. "] " .. sub.Name)
                end
            end
        end
    end

    -- PlayerGui
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        print("\n--- PLAYER GUI ---")
        for _, obj in ipairs(playerGui:GetDescendants()) do
            if obj:IsA("ScreenGui") then
                print("  ScreenGui: " .. obj.Name)
            elseif obj:IsA("Frame") then
                print("    Frame: " .. obj.Name)
            elseif obj:IsA("TextButton") then
                print("    Button: " .. obj.Name)
            elseif obj:IsA("TextLabel") then
                print("    Label: " .. obj.Name)
            elseif obj:IsA("LocalScript") then
                print("    LocalScript: " .. obj.Name)
            end
        end
    end
end

