-- SCAN : OBJETS ET MODÈLES
--============================================================
local OBJECT_CLASSES = {
    Model=true, Part=true, MeshPart=true, UnionOperation=true,
    CornerWedgePart=true, WedgePart=true, TrussPart=true,
    VehicleSeat=true, Seat=true, SpawnLocation=true,
    Folder=true, Configuration=true,
}

local function classify(inst) -- catégorie par heuristique
    local n = string.lower(inst.Name)
    local cls = inst.ClassName
    if OBJECT_CLASSES[cls] then
        if string.find(n, "car") or string.find(n, "vehicle") or string.find(n, "truck")
            or string.find(n, "truck") or string.find(n, "voiture") or string.find(n, "veh")
            or string.find(n, "bike") or string.find(n, "tractor") or string.find(n, "plane") then
            return "vehicles"
        elseif inst:IsA("Tool") or string.find(n, "item") or string.find(n, "objet")
            or string.find(n, "pickup") or string.find(n, "collect") or string.find(n, "wood")
            or string.find(n, "stone") or string.find(n, "iron") or string.find(n, "gold") then
            return "items"
        elseif string.find(n, "zone") or string.find(n, "chunk") or string.find(n, "region")
            or string.find(n, "plot") or string.find(n, "base") or string.find(n, "land") then
            return "config"
        end
        return "objects"
    end
    return nil
end

local function scanObjects(root, label)
    local queue = {root}
    local visited = 0
    local maxDepth = 30

    while #queue > 0 do
        if not batchWait() then return end
        local inst = table.remove(queue)
        visited = visited + 1
        State.scanned = State.scanned + 1

        if alive(inst) and matches(inst) then
            local cat = classify(inst)
            if cat then
                local line = string.format(
                    "%s\n  Classe   : %s\n  Chemin   : %s\n  Parent   : %s\n  Enfants  : %d",
                    inst.Name, inst.ClassName, shortPath(inst, 8),
                    alive(inst.Parent) and inst.Parent.Name or "orphan",
                    childrenCount(inst))
                local props = propsOf(inst)
                if props ~= "" then line = line .. "\n  Props    : " .. props end
                local attrs = attrsOf(inst)
                if attrs ~= "" then line = line .. "\n  Attributs: " .. attrs end
                local tags = tagsOf(inst)
                if tags ~= "" then line = line .. "\n  Tags     : " .. tags end
                addResult(cat, line .. "\n  " .. string.rep("─", 40))
            end

            local ok, kids = pcall(function() return inst:GetChildren() end)
            if ok then
                for _, child in ipairs(kids) do
                    if alive(child) then table.insert(queue, child) end
                end
            end
        end
    end
end

