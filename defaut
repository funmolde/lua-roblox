-- SCAN : PARAMÈTRES / CONFIGURATION / SYSTÈMES
--============================================================
local function scanConfig()
    addResult("config", "═══ SYSTÈMES DÉTECTÉS ═══")

    -- monnaies (leaderstats)
    local ok, stats = pcall(function() return LocalPlayer:FindFirstChild("leaderstats") end)
    if ok and stats then
        addResult("config", "Système monnaie : leaderstats")
        for _, child in ipairs(stats:GetChildren()) do
            addResult("config", string.format("  Statistique : %s = %s [%s]",
                child.Name, tostring(child.Value), child.ClassName))
        end
    end

    -- équipes
    local ok2, teams = pcall(function() return Teams:GetTeams() end)
    if ok2 then
        addResult("config", string.format("Système équipes : %d équipes", #teams))
        for _, t in ipairs(teams) do
            addResult("config", string.format("  Équipe : %s [%s]", t.Name, tostring(t.TeamColor)))
        end
    end

    -- spawn locations
    local ok3, spawns = pcall(function() return Workspace:GetDescendants() end)
    if ok3 then
        local spawnCount = 0
        for _, d in ipairs(spawns) do
            if d.ClassName == "SpawnLocation" then
                spawnCount = spawnCount + 1
                if spawnCount <= 20 then
                    addResult("config", string.format("  Spawn : %s à (%.0f, %.0f, %.0f)",
                        d.Name, d.Position.X, d.Position.Y, d.Position.Z))
                end
            end
        end
        addResult("config", string.format("Total SpawnLocations : %d", spawnCount))
    end

    -- dossiers de zones
    local ok4, wsKids = pcall(function() return Workspace:GetChildren() end)
    if ok4 then
        addResult("config", "Zones / Chunks dans Workspace :")
        for _, child in ipairs(wsKids) do
            if child:IsA("Folder") or child:IsA("Model") then
                local count = childrenCount(child)
                if count > 10 then
                    addResult("config", string.format("  Zone candidate : %s [%s] → %d objets",
                        child.Name, child.ClassName, count))
                end
            end
        end
    end

    -- postes de vente (Shop / Sell / Buy)
    local ok5, desc = pcall(function() return Workspace:GetDescendants() end)
    if ok5 then
        addResult("config", "Zones de vente / achat détectées :")
        local shown = 0
        for _, d in ipairs(desc) do
            if shown >= 30 then break end
            local n = string.lower(d.Name)
            if d:IsA("BasePart") and (string.find(n, "sell") or string.find(n, "shop")
                or string.find(n, "buy") or string.find(n, "vendre") or string.find(n, "vente")
                or string.find(n, "magasin") or string.find(n, "acheter")) then
                addResult("config", string.format("  %s [%s] à (%.0f, %.0f, %.0f) → %s",
                    d.Name, d.ClassName, d.Position.X, d.Position.Y, d.Position.Z, getPath(d)))
                shown = shown + 1
            end
        end
    end
end

