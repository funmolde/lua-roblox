local function scanConfig()
    addResult("config", "═══ SYSTÈMES ═══")
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        addResult("config", "Monnaie : leaderstats")
        for _, ch in ipairs(stats:GetChildren()) do
            local v = ""
            pcall(function() v = tostring(ch.Value) end)
            addResult("config", string.format("  %s = %s [%s]", ch.Name, v, ch.ClassName))
        end
    end
    local ok, teams = pcall(Teams.GetTeams, Teams)
    if ok then
        addResult("config", "Équipes : " .. #teams)
        for _, t in ipairs(teams) do
            addResult("config", string.format("  %s [%s]", t.Name, tostring(t.TeamColor)))
        end
    end
    local ok2, desc = pcall(Workspace.GetDescendants, Workspace)
    if ok2 then
        local spawns, shops = 0, {}
        for _, d in ipairs(desc) do
            if d.ClassName == "SpawnLocation" then
                spawns += 1
                if spawns <= 15 then
                    addResult("config", string.format("  Spawn: %s (%.0f,%.0f,%.0f)",
                        d.Name, d.Position.X, d.Position.Y, d.Position.Z))
                end
            end
            local n = string.lower(d.Name)
            if d:IsA("BasePart") and (string.find(n, "sell") or string.find(n, "shop")
                or string.find(n, "buy") or string.find(n, "vendre") or string.find(n, "vente")
                or string.find(n, "magasin") or string.find(n, "acheter")) then
                table.insert(shops, string.format("  %s [%s] (%.0f,%.0f,%.0f)",
                    d.Name, d.ClassName, d.Position.X, d.Position.Y, d.Position.Z))
                if #shops >= 25 then break end
            end
        end
        addResult("config", "Spawns total : " .. spawns)
        if #shops > 0 then
            addResult("config", "Zones de vente/achat :")
            for _, s in ipairs(shops) do addResult("config", s) end
        end
    end
end

local function scanRelations()
    addResult("relations", "═══ RELATIONS SYSTÈMES ═══")
    local svc, ctrl, cfg = 0, 0, 0
    for _, m in ipairs(State.results.modules) do
        if string.find(m, "Service %(") then svc += 1 end
        if string.find(m, "Controller %(") then ctrl += 1 end
        if string.find(m, "Config") then cfg += 1 end
    end
    addResult("relations", string.format("Services: %d | Controllers: %d | Configs: %d", svc, ctrl, cfg))
    addResult("relations", "→ Remotes et leurs chemins :")
    for _, r in ipairs(State.results.remotes) do
        local name = string.match(r, "^([^\n]+)")
        if name then
            local path = string.match(r, "game%..- %[[%w]+%]")
            addResult("relations", string.format("  %s → %s", name, path or "?"))
        end
    end
    addResult("relations", "→ Interactions → Systèmes :")
    for _, i in ipairs(State.results.interactions) do
        local name = string.match(i, "^([^\n]+)")
        if name then
            local ln = string.lower(name)
            local sys = "inconnu"
            if string.find(ln, "sell") or string.find(ln, "vente") then sys = "VENTE"
            elseif string.find(ln, "buy") or string.find(ln, "achat") then sys = "ACHAT"
            elseif string.find(ln, "collect") or string.find(ln, "pickup") then sys = "COLLECTE"
            elseif string.find(ln, "car") or string.find(ln, "vehicle") or string.find(ln, "veh") then sys = "VÉHICULES"
            elseif string.find(ln, "door") or string.find(ln, "gate") then sys = "ZONES" end
            addResult("relations", string.format("  [%s] → %s", name, sys))
        end
    end
end

