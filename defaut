-- ============ FONCTION DE CLASSIFICATION ============

local function classify(obj)
    if obj:IsA("Model") then
        table.insert(RESULTS.MODELS, obj:GetFullName())
    elseif obj:IsA("BasePart") then
        table.insert(RESULTS.PARTS, obj:GetFullName())
    elseif obj:IsA("Tool") then
        table.insert(RESULTS.TOOLS, obj:GetFullName())
    elseif obj:IsA("RemoteEvent") then
        table.insert(RESULTS.REMOTE_EVENTS, obj:GetFullName())
    elseif obj:IsA("RemoteFunction") then
        table.insert(RESULTS.REMOTE_FUNCTIONS, obj:GetFullName())
    elseif obj:IsA("Script") then
        table.insert(RESULTS.SCRIPTS, obj:GetFullName())
    elseif obj:IsA("LocalScript") then
        table.insert(RESULTS.LOCAL_SCRIPTS, obj:GetFullName())
    elseif obj:IsA("ModuleScript") then
        table.insert(RESULTS.MODULE_SCRIPTS, obj:GetFullName())
    elseif obj:IsA("Sound") then
        table.insert(RESULTS.SOUNDS, obj:GetFullName())
    elseif obj:IsA("Light") or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
        table.insert(RESULTS.LIGHTS, obj:GetFullName() .. " [Range: " .. tostring(obj.Range or "N/A") .. "]")
    elseif obj:IsA("ScreenGui") or obj:IsA("Frame") or obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("ImageLabel") then
        table.insert(RESULTS.GUI, obj:GetFullName())
    elseif obj:IsA("Folder") then
        table.insert(RESULTS.FOLDERS, obj:GetFullName())
    elseif obj:IsA("Animation") or obj:IsA("AnimationTrack") then
        table.insert(RESULTS.ANIMATIONS, obj:GetFullName())
    elseif obj:IsA("ParticleEmitter") then
        table.insert(RESULTS.PARTICLES, obj:GetFullName())
    elseif obj:IsA("SpecialMesh") or obj:IsA("FileMesh") or obj:IsA("BlockMesh") or obj:IsA("CylinderMesh") then
        table.insert(RESULTS.MESHES, obj:GetFullName())
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        table.insert(RESULTS.DECALS, obj:GetFullName())
    elseif obj:IsA("ClickDetector") then
        table.insert(RESULTS.CLICK_DETECTORS, obj:GetFullName())
    elseif obj:IsA("ProximityPrompt") then
        table.insert(RESULTS.PROXIMITY_PROMPTS, obj:GetFullName())
    elseif obj:IsA("Beam") then
        table.insert(RESULTS.BEAMS, obj:GetFullName())
    elseif obj:IsA("Trail") then
        table.insert(RESULTS.TRAILS, obj:GetFullName())
    elseif obj:IsA("IntValue") or obj:IsA("StringValue") or obj:IsA("BoolValue") or obj:IsA("NumberValue") or obj:IsA("ObjectValue") or obj:IsA("Vector3Value") or obj:IsA("CFrameValue") then
        local value = "?"
        pcall(function() value = tostring(obj.Value) end)
        table.insert(RESULTS.VALUES, obj:GetFullName() .. " = " .. value)
    else
        table.insert(RESULTS.OTHER, obj:GetFullName() .. " [" .. obj.ClassName .. "]")
    end
end

