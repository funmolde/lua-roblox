function refreshResults()
    for _, ch in ipairs(resultsFrame:GetChildren()) do
        if ch:IsA("TextLabel") then ch:Destroy() end
    end
    local lines = {}
    for cat, list in pairs(State.results) do
        if #list > 0 then
            table.insert(lines, {cat .. " (" .. #list .. ")", Color3.fromRGB(120, 200, 255)})
            for _, line in ipairs(list) do
                table.insert(lines, {line, Color3.fromRGB(200, 200, 215)})
            end
        end
    end
    local maxShown = 150
    for i, entry in ipairs(lines) do
        if i > maxShown then break end
        make("TextLabel", {
            Size = UDim2.new(1, -8, 0, 15),
            BackgroundTransparency = 1,
            Text = entry[1],
            TextColor3 = entry[2],
            TextSize = 9,
            Font = Enum.Font.Code,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, resultsFrame)
    end
    resultsFrame.CanvasSize = UDim2.new(0, 0, 0, #lines * 18)
end

