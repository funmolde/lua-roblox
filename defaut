-- SCAN : REMOTES / COMMUNICATIONS RÉSEAU
--============================================================
local REMOTE_CLASSES = {
    RemoteEvent=true, RemoteFunction=true,
    BindableEvent=true, BindableFunction=true,
}

local function scanRemotes()
    local queue = {ReplicatedStorage, ReplicatedFirst, Workspace, StarterGui, StarterPlayer}

    while #queue > 0 do
        if not batchWait() then return end
        local inst = table.remove(queue)
        State.scanned = State.scanned + 1

        if alive(inst) then
            if REMOTE_CLASSES[inst.ClassName] and matches(inst) then
                local line = string.format(
                    "%s\n  Type     : %s\n  Chemin   : %s\n  Parent   : %s",
                    inst.Name, inst.ClassName, getPath(inst),
                    alive(inst.Parent) and inst.Parent.Name or "orphan")
                -- signature des méthodes connues par introspection des autres scripts
                local hints = {}
                if inst.ClassName == "RemoteEvent" then
                    hints = {"FireServer(player, ...)", "FireClient(player, ...)", "FireAllClients(...)"}
                elseif inst.ClassName == "RemoteFunction" then
                    hints = {"InvokeServer(...)", "InvokeClient(player, ...)"}
                elseif inst.ClassName == "BindableEvent" then
                    hints = {"Fire(...)"}
                elseif inst.ClassName == "BindableFunction" then
                    hints = {"Invoke(...)"}
                end
                line = line .. "\n  Méthodes : " .. table.concat(hints, " / ")
                addResult("remotes", line .. "\n  " .. string.rep("─", 40))
            end

            local ok, kids = pcall(function() return inst:GetChildren() end)
            if ok then
                for _, child in ipairs(kids) do
                    if alive(child) then table.insert(queue, child) end
                end
            end
        end
    end
end

--============================================================
-- SCAN : SCRIPTS ET MODULES
--============================================================
local SCRIPT_CLASSES = {
    Script=true, LocalScript=true, ModuleScript=true,
}

local function scanScripts()
    local queue = {ReplicatedStorage, ReplicatedFirst, StarterGui, StarterPlayer, Workspace, LocalPlayer}

    while #queue > 0 do
        if not batchWait() then return end
        local inst = table.remove(queue)
        State.scanned = State.scanned + 1

        if alive(inst) then
            if SCRIPT_CLASSES[inst.ClassName] and matches(inst) then
                local src = ""
                local ok, code = pcall(function() return inst.Source end) -- si exécuteur expose
                if ok and type(code) == "string" then
                    src = "\n  Source   : OUI (accroche les fonctions ici)"
                else
                    src = "\n  Source   : protégé ( bytecode luau )"
                end

                local line = string.format(
                    "%s\n  Type     : %s\n  Chemin   : %s%s",
                    inst.Name, inst.ClassName, getPath(inst), src)

                -- analyse heuristique du contenu si source lisible
                if type(code) == "string" then
                    local funcs = {}
                    for fn in string.gmatch(code, "function%s+([%w_:%.]+)") do
                        table.insert(funcs, fn)
                        if #funcs >= 12 then break end
                    end
                    if #funcs > 0 then
                        line = line .. "\n  Fonctions: " .. table.concat(funcs, ", ")
                    end
                    local requires = {}
                    for req in string.gmatch(code, "require%s*%(%s*script[%w_%.]*([%w_%.]+)") do
                        table.insert(requires, req)
                        if #requires >= 8 then break end
                    end
                    if #requires > 0 then
                        line = line .. "\n  Requiert : " .. table.concat(requires, ", ")
                    end
                end

                -- classification Knit
                local n = string.lower(inst.Name)
                local role = "module"
                if string.find(n, "service") then role = "Service (Knit)"
                elseif string.find(n, "controller") then role = "Controller (Knit)"
                elseif string.find(n, "config") or string.find(n, "settings") then role = "Configuration"
                elseif string.find(n, "item") or string.find(n, "data") or string.find(n, "db") then role = "Base de données"
                elseif string.find(n, "ui") or string.find(n, "interface") then role = "Module UI"
                end
                line = line .. "\n  Rôle     : " .. role

                addResult("modules", line .. "\n  " .. string.rep("─", 40))
            end

            local ok, kids = pcall(function() return inst:GetChildren() end)
            if ok then
                for _, child in ipairs(kids) do
                    if alive(child) then table.insert(queue, child) end
                end
            end
        end
    end
end

--============================================================
-- SCAN : INTERACTIONS
--============================================================
local function scanInteractions()
    local queue = {Workspace, StarterGui, StarterPlayer, ReplicatedStorage}

    while #queue > 0 do
        if not batchWait() then return end
        local inst = table.remove(queue)
        State.scanned = State.scanned + 1

        if alive(inst) then
            local cls = inst.ClassName
            local hit = false
            local kind = ""

            if cls == "ProximityPrompt" then
                local ok, actionText = pcall(function() return inst.ActionText end)
                local ok2, holdDur = pcall(function() return inst.HoldDuration end)
                local ok3, objName = pcall(function() return inst.ObjectName end)
                kind = string.format(
                    "ProximityPrompt\n  Action   : %s\n  Objet    : %s\n  HoldDur  : %s\n  Chemin   : %s",
                    tostring(actionText), tostring(objName), tostring(holdDur), getPath(inst))
                hit = true
            elseif cls == "ClickDetector" then
                kind = string.format("ClickDetector\n  MaxDist  : %s\n  Chemin   : %s",
                    tostring(pcall(function() return inst.MaxActivationDistance end) and inst.MaxActivationDistance or "?"),
                    getPath(inst))
                hit = true
            elseif cls == "TouchTransmitter" then
                kind = string.format("TouchTransmitter (Touched)\n  Parent   : %s [%s]\n  Chemin   : %s",
                    alive(inst.Parent) and inst.Parent.Name or "?",
                    alive(inst.Parent) and inst.Parent.ClassName or "?",
                    getPath(inst))
                hit = true
            elseif cls == "Tool" then
                kind = string.format("Tool\n  Grip     : %s\n  Chemin   : %s",
                    tostring(pcall(function() return tostring(inst.Grip) end) and tostring(inst.Grip) or "?"),
                    getPath(inst))
                hit = true
            elseif cls == "VehicleSeat" then
                kind = string.format("VehicleSeat\n  MaxSpeed : %s\n  Torque   : %s\n  Chemin   : %s",
                    tostring(pcall(function() return inst.MaxSpeed end) and inst.MaxSpeed or "?"),
                    tostring(pcall(function() return inst.Torque end) and inst.Torque or "?"),
                    getPath(inst))
                hit = true
            end

            if hit and matches(inst) then
                addResult("interactions", inst.Name .. "\n  " .. kind .. "\n  " .. string.rep("─", 40))
            end

            local ok, kids = pcall(function() return inst:GetChildren() end)
            if ok then
                for _, child in ipairs(kids) do
                    if alive(child) then table.insert(queue, child) end
                end
            end
        end
    end
end

