--============================================================
-- UTILITAIRES
--============================================================
local function alive(obj) -- objet encore existant ?
    if not obj then return false end
    if not pcall(function() return obj.Parent end) then return false end
    return obj.Parent ~= nil or obj == workspace or obj == game
end

local function getPath(obj) -- chemin complet sous game
    local parts, cur = {}, obj
    while cur and cur ~= game do
        local ok, name = pcall(function() return cur.Name end)
        if not ok then break end
        local cls = pcall(function() return cur.ClassName end) and cur.ClassName or "?"
        table.insert(parts, 1, name .. " [" .. cls .. "]")
        cur = pcall(function() return cur.Parent end) and cur.Parent or nil
    end
    return "game." .. table.concat(parts, ".")
end

local function shortPath(obj, maxDepth) -- chemin court
    local parts, cur, i = {}, obj, 0
    while cur and cur ~= game and i < (maxDepth or 6) do
        local ok = pcall(function() return cur.Name end)
        if not ok then break end
        table.insert(parts, 1, cur.Name)
        cur = pcall(function() return cur.Parent end) and cur.Parent or nil
        i = i + 1
    end
    return table.concat(parts, "/")
end

local function propsOf(inst) -- propriétés lisibles
    local out = {}
    local checks = {
        {"Position",   function(v) return v and ("(" .. tostring(math.floor(v.X*100)/100) .. ", " .. tostring(math.floor(v.Y*100)/100) .. ", " .. tostring(math.floor(v.Z*100)/100) .. ")") or nil end},
        {"Orientation",function(v) return v and ("(" .. tostring(v.X) .. ", " .. tostring(v.Y) .. ", " .. tostring(v.Z) .. ")") or nil end},
        {"Size",       function(v) return v and ("(" .. tostring(v.X) .. ", " .. tostring(v.Y) .. ", " .. tostring(v.Z) .. ")") or nil end},
        {"ClassName",  tostring},
        {"Transparency", tostring},
        {"Anchored",   tostring},
        {"CanCollide", tostring},
        {"Material",   tostring},
        {"Color",      tostring},
        {"BrickColor", tostring},
        {"Value",      tostring},
        {"Text",       tostring},
        {"Visible",    tostring},
        {"Health",     tostring},
        {"MaxHealth",  tostring},
        {"TeamColor",  tostring},
        {"RequiresLineOfSight", tostring},
        {"HoldDuration", tostring},
        {"ActionText", tostring},
        {"ObjectName", tostring},
        {"Cooldown",   tostring},
        {"Enabled",    tostring},
    }
    for _, pair in ipairs(checks) do
        local ok, v = pcall(function() return inst[pair[1]] end)
        if ok and v ~= nil then
            local ok2, formatted = pcall(pair[2], v)
            if ok2 and formatted ~= nil then
                table.insert(out, pair[1] .. "=" .. tostring(formatted))
            end
        end
    end
    return table.concat(out, " | ")
end

local function attrsOf(inst) -- attributs custom
    local out = {}
    local ok, attrs = pcall(function() return inst:GetAttributes() end)
    if ok and attrs then
        for k, v in pairs(attrs) do
            table.insert(out, k .. "=" .. tostring(v))
        end
    end
    return table.concat(out, ", ")
end

local function tagsOf(inst)
    local ok, tags = pcall(function() return CollectionService:GetTags(inst) end)
    if ok and #tags > 0 then return table.concat(tags, ",") end
    return ""
end

local function childrenCount(inst)
    local ok, n = pcall(function() return #inst:GetChildren() end)
    return ok and n or 0
end

local function matches(inst) -- filtre recherche
    if State.search == "" then return true end
    local ok, name = pcall(function() return string.lower(inst.Name) end)
    if ok and string.find(name, string.lower(State.search)) then return true end
    local ok2, cls = pcall(function() return string.lower(inst.ClassName) end)
    return ok2 and string.find(cls, string.lower(State.search)) ~= nil
end

local function addResult(category, line)
    if not State.filters[category] and category ~= "architecture" and category ~= "relations" then return end
    table.insert(State.results[category], line)
    State.counts[category] = State.counts[category] + 1
end

local function batchWait() -- yield pour éviter le gel
    task.wait()
    if State.scanned % State.batch == 0 then
        task.wait(0.05)
    end
    return not State.abort
end

