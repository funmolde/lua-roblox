--============================================================
local function alive(obj)
    if not obj then return false end
    local ok, p = pcall(function() return obj.Parent end)
    return ok and p ~= nil
end

local function getPath(obj)
    local parts, cur = {}, obj
    while cur and cur ~= game do
        local ok, n = pcall(function() return cur.Name end)
        if not ok then break end
        local cls = "?"
        pcall(function() cls = cur.ClassName end)
        table.insert(parts, 1, n .. " [" .. cls .. "]")
        cur = pcall(function() return cur.Parent end) and cur.Parent or nil
    end
    return "game." .. table.concat(parts, ".")
end

local function shortPath(obj, maxDepth)
    local parts, cur, i = {}, obj, 0
    while cur and cur ~= game and i < (maxDepth or 6) do
        local ok = pcall(function() return cur.Name end)
        if not ok then break end
        table.insert(parts, 1, cur.Name)
        cur = pcall(function() return cur.Parent end) and cur.Parent or nil
        i += 1
    end
    return table.concat(parts, "/")
end

local function propsOf(inst)
    local out = {}
    local checks = {
        {"Position",   true}, {"Size", true}, {"Anchored", false},
        {"CanCollide", false}, {"Transparency", false}, {"Material", false},
        {"Value", false}, {"Text", false}, {"Health", false},
        {"MaxHealth", false}, {"HoldDuration", false},
        {"ActionText", false}, {"ObjectName", false}, {"Cooldown", false},
        {"MaxSpeed", false}, {"Torque", false}, {"Enabled", false},
    }
    for _, pair in ipairs(checks) do
        local ok, v = pcall(function() return inst[pair[1]] end)
        if ok and v ~= nil then
            if pair[1] == "Position" or pair[1] == "Size" then
                v = string.format("(%.1f, %.1f, %.1f)", v.X, v.Y, v.Z)
            end
            table.insert(out, pair[1] .. "=" .. tostring(v))
        end
    end
    return table.concat(out, " | ")
end

local function attrsOf(inst)
    local ok, attrs = pcall(function() return inst:GetAttributes() end)
    if ok and attrs then
        local out = {}
        for k, v in pairs(attrs) do table.insert(out, k .. "=" .. tostring(v)) end
        if #out > 0 then return table.concat(out, ", ") end
    end
    return ""
end

local function tagsOf(inst)
    local ok, tags = pcall(function() return CollectionService:GetTags(inst) end)
    if ok and #tags > 0 then return table.concat(tags, ",") end
    return ""
end

local function childrenCount(inst)
    local ok, n = pcall(function() return #inst:GetChildren() end)
    return ok and n or 0
end

local function matches(inst)
    if State.search == "" then return true end
    local s = string.lower(State.search)
    local ok1, n = pcall(function() return string.lower(inst.Name) end)
    local ok2, c = pcall(function() return string.lower(inst.ClassName) end)
    return (ok1 and string.find(n, s)) or (ok2 and string.find(c, s))
end

local function addResult(cat, line)
    table.insert(State.results[cat], line)
    State.counts[cat] += 1
end

local function batchWait()
    task.wait()
    if State.scanned % State.batch == 0 then task.wait(0.05) end
    return not State.abort
end

