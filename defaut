local function refreshResults()
    -- vider
    for _, child in ipairs(resultsFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    local lines = {}
    for cat, list in pairs(State.results) do
        if #list > 0 then
            table.insert(lines, {cat .. " (" .. #list .. ")", Color3.fromRGB(120, 200, 255)})
            for _, line in ipairs(list) do
                table.insert(lines, {line, Color3.fromRGB(200, 200, 215)})
            end
        end
    end
    -- limiter pour la performance mobile
    local maxShown = 120
    for i, entry in ipairs(lines) do
        if i > maxShown then break end
        make("TextLabel", {
            Size = UDim2.new(1, -8, 0, 16),
            BackgroundTransparency = 1,
            Text = entry[1],
            TextColor3 = entry[2],
            TextSize = 10,
            Font = Enum.Font.Code,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = resultsFrame,
        })
    end
    resultsFrame.CanvasSize = UDim2.new(0, 0, 0, #lines * 20)
end

-- Mise à jour de la barre de progression
function GUI.updateProgress(pct, label)
    progFill.Size = UDim2.new(pct / 100, 0, 1, 0)
    progLabel.Text = string.format("%s — %d%% (%d objets)", label or "", pct, State.scanned)
    for name, lbl in pairs(counterLabels) do
        local key = string.lower(string.sub(name, 1, 5))
        local map = {
            Objets="objects", Remotes="remotes", Modules="modules",
            Interact="interactions", Items="items", Vehic="vehicles",
            GUI="gui", Config="config",
        }
        local cat = map[name]
        if cat then
            lbl.Text = name .. ": " .. State.counts[cat]
        end
    end
end

function GUI.scanDone()
    progFill.Size = UDim2.new(1, 0, 1, 0)
    progLabel.Text = "Scan terminé — " .. State.scanned .. " objets analysés"
    refreshResults()
end

