-- SCAN : CARTOGRAPHIE DES RELATIONS
--============================================================
local function scanRelations()
    addResult("relations", "═══ CARTOGRAPHIE DES DÉPENDANCES ═══")

    -- RemoteEvent par système : où est-il utilisé ?
    addResult("relations", "→ Remotes par chemin (relie au système) :")
    for _, r in ipairs(State.results.remotes) do
        if string.find(r, "Remote") and not string.find(r, "Bindable") then
            -- extraire le chemin
            for path in string.gmatch(r, "game%.[%w%.%[%]%s%w]+") do
                addResult("relations", "  Remote détecté : " .. path)
                break
            end
        end
    end

    addResult("relations", "→ Modules par rôle :")
    local services, controllers, configs = {}, {}, {}
    for _, m in ipairs(State.results.modules) do
        if string.find(m, "Service %(") then table.insert(services, string.match(m, "^([%w%s_]+)\n")) end
        if string.find(m, "Controller %(") then table.insert(controllers, string.match(m, "^([%w%s_]+)\n")) end
        if string.find(m, "Configuration") then table.insert(configs, string.match(m, "^([%w%s_]+)\n")) end
    end
    addResult("relations", string.format("  Services    : %d", #services))
    addResult("relations", string.format("  Controllers : %d", #controllers))
    addResult("relations", string.format("  Configs     : %d", #configs))

    addResult("relations", "→ Interactions → Systèmes :")
    for _, i in ipairs(State.results.interactions) do
        local name = string.match(i, "^([^\n]+)")
        if name then
            local sys = "inconnu"
            local ln = string.lower(name)
            if string.find(ln, "sell") or string.find(ln, "vente") then sys = "Système de vente"
            elseif string.find(ln, "buy") or string.find(ln, "achat") then sys = "Système d'achat"
            elseif string.find(ln, "collect") or string.find(ln, "pickup") then sys = "Système de collecte"
            elseif string.find(ln, "car") or string.find(ln, "vehicle") then sys = "Système de véhicules"
            elseif string.find(ln, "door") or string.find(ln, "gate") then sys = "Système de zones"
            end
            addResult("relations", string.format("  [%s] → %s", name, sys))
        end
    end

    addResult("relations", "→ Interface → Systèmes :")
    for _, g in ipairs(State.results.gui) do
        local name = string.match(g, "^([^\n]+)")
        if name then
            addResult("relations", "  GUI : " .. name .. " → liée à l'affichage/contrôle d'une mécanique")
        end
    end
end

--============================================================
-- BOUCLE PRINCIPALE DE SCAN
--============================================================
local function runScan()
    State.abort    = false
    State.running  = true
    State.scanned  = 0
    for k, v in pairs(State.counts) do State.counts[k] = 0 end
    for k, v in pairs(State.results) do State.results[k] = {} end
    State.seen = {}

    -- estimation du total pour la barre de progression
    local ok, all = pcall(function() return game:GetDescendants() end)
    State.total = ok and #all or 10000

    local steps = {
        {"Architecture", scanArchitecture},
        {"Objets & Modèles", function() scanObjects(Workspace) end},
        {"Objets Replicated", function() scanObjects(ReplicatedStorage) end},
        {"Objets StarterPlayer", function() scanObjects(StarterPlayer) end},
        {"Remotes", scanRemotes},
        {"Scripts & Modules", scanScripts},
        {"Interactions", scanInteractions},
        {"Interface", scanGui},
        {"Paramètres", scanConfig},
        {"Relations", scanRelations},
    }

    for i, step in ipairs(steps) do
        if State.abort then break end
        local ok, err = pcall(step[2])
        if not ok then
            warn("Erreur pendant " .. step[1] .. ": " .. tostring(err))
        end
        local pct = math.floor((i / #steps) * 100)
        if GUI.updateProgress then GUI.updateProgress(pct, step[1]) end
        task.wait(0.1)
    end

    State.running = false
    if GUI.scanDone then GUI.scanDone() end
end

